{% extends 'base.html.twig' %}

{% block title %}Locality index{% endblock %}

{% block body %}
    <h1>Locality index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Municipality</th>
                <th>County</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for locality in localities %}
            <tr>
                <td>{{ locality.id }}</td>
                <td>{{ locality.name }}</td>
                <td>{{ locality.municipality }}</td>
                <td>{{ locality.county }}</td>
                <td>
                    <a href="{{ path('app_locality_show', {'id': locality.id}) }}">show</a>
                    <a href="{{ path('app_locality_edit', {'id': locality.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_locality_new') }}">Create new</a>
{% endblock %}
