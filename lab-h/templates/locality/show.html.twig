{% extends 'base.html.twig' %}

{% block title %}Locality{% endblock %}

{% block body %}
    <h1>Locality</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ locality.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ locality.name }}</td>
            </tr>
            <tr>
                <th>Municipality</th>
                <td>{{ locality.municipality }}</td>
            </tr>
            <tr>
                <th>County</th>
                <td>{{ locality.county }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_locality_index') }}">back to list</a>

    <a href="{{ path('app_locality_edit', {'id': locality.id}) }}">edit</a>

    {{ include('locality/_delete_form.html.twig') }}
{% endblock %}
