<?xml version='1.0' encoding='utf-8'?>
<widget id="pl.edu.zut.wi.ni57820" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Maksymilian 57820</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="pm57820@zut.edu.pl" href="https://www.wi.zut.edu.pl">
        Maksymilian Podgórski
    </author>
    <platform name="electron">
        <icon src="res/electron/icon.png" />
